<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OpenSL1 – Rane SL1 driver</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="OpenSL1">
        <pkg-ref id="org.opensl1.driver"/>
    </choice>
    <pkg-ref id="org.opensl1.driver" version="@VERSION@" onConclusion="none">OpenSL1-component.pkg</pkg-ref>
</installer-gui-script>
